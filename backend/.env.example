# Copy this file to .env and fill in real values.
#   cp .env.example .env   (or:  Copy-Item .env.example .env)

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/internship_alloc

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# App
APP_NAME=Smart Internship Allocation System
COMPANY_NAME=Smart Internship Company
DEBUG=True
